# Salin ke .env.local dan isi. JANGAN commit .env.local.

# Supabase — publik (boleh di klien)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase — RAHASIA (server-only, JANGAN diekspos ke klien)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Keamanan
ADMIN_JWT_AUD=admin
# IP allowlist opsional, pisahkan koma (kosong = nonaktif)
ADMIN_IP_ALLOWLIST=
