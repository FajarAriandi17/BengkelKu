# Salin file ini ke .env di root repo, lalu isi nilainya.
#   cp .env.example .env
#
# JANGAN commit .env. .gitignore sudah mengabaikannya.

# --- Supabase (dari Settings > API di dashboard Supabase Anda) ---------------

# Publik. Disisipkan ke client bundle saat BUILD (build-arg di docker-compose).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# RAHASIA. Hanya dibaca server saat RUNTIME. Jangan pernah taruh di client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Konfigurasi opsional ----------------------------------------------------

# Audiensi JWT admin (middleware mengecek aud=admin).
ADMIN_JWT_AUD=admin

# IP allowlist, pisahkan koma. Kosong = nonaktif.
ADMIN_IP_ALLOWLIST=

# Port host yang dipakai (ubah kalau 3000/8080 sudah dipakai).
ADMIN_WEB_PORT=3000
LANDING_PAGE_PORT=8080
